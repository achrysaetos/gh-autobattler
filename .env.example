# Server token for public GraphQL reads (a fine-grained token with no permissions is enough).
# Without it, GitHub ingestion is disabled and only demo players change.
GITHUB_TOKEN=

# GitHub OAuth app. Callback URL: ${PUBLIC_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where browsers reach the app. In dev the Vite server proxies /auth, /api, and /ws.
PUBLIC_URL=http://localhost:5173

# HMAC key for the session cookie. Required (32+ chars) in production.
SESSION_SECRET=

PORT=8787
HOST=0.0.0.0
DATABASE_PATH=data/pushfront.db
CLIENT_DIR=dist/client

# Local testing.
DEV_AUTH=0
DEMO_PLAYERS=0
ROUND_HOURS=168
INTERMISSION_MINUTES=60
